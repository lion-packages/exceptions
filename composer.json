{
    "name": "lion/exceptions",
    "description": "Exception handling and serializations.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Lion\\Exceptions\\": "src/LionExceptions/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.11 || ^4.0",
        "lion/test": "^3.2 || ^4.0",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "overtrue/phplint": "^9.5",
        "infection/infection": "^0.29.14 || ^0.32.0 || ^0.33.0 || ^0.34.0"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": false
        }
    }
}
